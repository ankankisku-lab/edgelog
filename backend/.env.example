# Copy this file to backend/.env and fill in the values. Restart the backend after changes.
# backend/.env is git-ignored: never commit real keys.

# --- AI (OpenRouter) -------------------------------------------------------
# Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Comma-separated, tried in order (the next one is used when one is rate-limited).
# Free variants end in ":free" (free tier: ~20 requests/min, 50/day without credits). qwen/qwen3-vl-8b-instruct is paid.
VISION_MODELS=nvidia/nemotron-3.5-super-vl:free,dots-studio/dots-3-note-preview:free,qwen/qwen3-vl-8b-instruct
ASSISTANT_MODELS=nvidia/nemotron-3.5-super-vl:free,dots-studio/dots-3-note-preview:free,qwen/qwen3-vl-8b-instruct

# --- Google Drive (optional) -----------------------------------------------
# Google Cloud Console > APIs & Services > Credentials > OAuth client ID (Web application).
# Authorized redirect URI: http://localhost:8000/api/drive/auth/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Encrypts the stored Drive tokens. Generate with:
#   .venv/Scripts/python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
APP_SECRET_KEY=
SYNC_INTERVAL_MINUTES=10

# --- Database (optional) ---------------------------------------------------
# Defaults to SQLite in backend/data/journal.db. For PostgreSQL:
# DATABASE_URL=postgresql+psycopg2://journal:journal@localhost:5432/journal
